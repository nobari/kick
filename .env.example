# Public URL used in Slack reinstall links and generated metadata.
NEXT_PUBLIC_SITE_URL=https://kick.bozmoz.com

# Slack app credentials. Rotate the legacy credentials before deploying.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_STATE_SECRET=

# Shared only between Vercel and the Cloudflare scheduled Worker.
CRON_SECRET=
# Enable only after the external scheduler is connected and verified.
KICK_SCHEDULER_ENABLED=false
# Enable after Slack im:write permission and installation consent are approved.
KICK_RITUALS_DM_ENABLED=false

# Postgres is the only runtime backend; this optional value rejects stale configs.
# Server-only credentials; never use NEXT_PUBLIC_ prefixes.
# Keep production credentials out of preview environments.
KICK_STORAGE_BACKEND=postgres
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# 32 random bytes, base64 encoded. Must match the key used during import.
# Keep this separate from BACKUP_KEY_BASE64; do not rotate without re-encryption.
KICK_DATA_KEY=
