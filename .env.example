# Public URL used in Slack reinstall links and generated metadata.
NEXT_PUBLIC_SITE_URL=https://slack-kickbot.vercel.app

# Slack app credentials. Rotate the legacy credentials before deploying.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_STATE_SECRET=

# Vercel OIDC federation to the existing slack-manage Firestore database.
# VERCEL_OIDC_TOKEN is supplied automatically by Vercel.
GCP_PROJECT_ID=slack-manage
GCP_PROJECT_NUMBER=69564326211
GCP_SERVICE_ACCOUNT_EMAIL=vercel-kick@slack-manage.iam.gserviceaccount.com
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel

# Optional local fallback: a complete service-account JSON serialized on one line.
FIREBASE_SERVICE_ACCOUNT_KEY=
