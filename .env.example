# Public URL used in Slack reinstall links and generated metadata.
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app

# Slack app credentials. Rotate the legacy credentials before deploying.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_STATE_SECRET=

# Paste the complete Google Cloud service-account JSON on one line.
# The account needs Firestore access to the existing slack-manage database.
FIREBASE_SERVICE_ACCOUNT_KEY=
