{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kick-ritual-scheduler",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-17",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "limits": { "cpu_ms": 10 },
  "observability": { "enabled": true }
}
